# context.dev — reads the Dubai rental listings WebDB.
# Server-side only; this key must never reach the browser.
CONTEXT_DEV_API_KEY=ctxt_secret_xxx

# Optional. Defaults to the collection this project was built against.
# CONTEXT_COLLECTION_ID=col_...

# ElevenLabs — the voice agent.
ELEVENLABS_API_KEY=sk_xxx

# Written by `npm run sync-agent` on first run. Do not hand-edit.
ELEVENLABS_AGENT_ID=agent_xxx
