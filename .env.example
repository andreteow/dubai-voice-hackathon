# context.dev — reads the Dubai rental listings WebDB.
# Server-side only; this key must never reach the browser.
CONTEXT_DEV_API_KEY=ctxt_secret_xxx

# Optional. Defaults to the collection this project was built against.
# CONTEXT_COLLECTION_ID=col_...

# ElevenLabs — the voice agent.
ELEVENLABS_API_KEY=sk_xxx

# Written by `npm run sync-agent` on first run. Do not hand-edit.
ELEVENLABS_AGENT_ID=agent_xxx

# Supabase — stores the early-access list from the landing page.
# Optional: without these the sign-up form still accepts addresses, it just
# does not record them, and the API says so with `stored: false`.
# The table has RLS on with no policies, so this key can only call the
# `join_second_opinion_waitlist` function — it cannot read anyone's address.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
